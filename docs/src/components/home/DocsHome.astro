---
import ShellIcon from "../shell/ShellIcon.astro";
const cards = [
  {
    title: "Any JavaScript website",
    description:
      "Connect your project, define content, and render your first page. Works with any framework.",
    href: "/quick-start/",
    icon: "code",
    action: "Start integrating",
  },
  {
    title: "Built with Astro",
    description:
      "Start static. Add shared clients, live previews, metadata, and ordinary HTML forms.",
    href: "/guides/astro/",
    icon: "bolt",
    action: "Set up Astro",
  },
  {
    title: "Model your content",
    description:
      "Documents, collections, relationships, and every field option. Give editors clear boundaries.",
    href: "/guides/structure/",
    icon: "layers",
    action: "Define your schema",
  },
] as const;
---

<div class="not-content">
  <section class="ama-home-hero">
    <p class="ama-eyebrow">ATMYAPP FOR DEVELOPERS</p>
    <h1>Your website.<br /><span>Your client’s content.</span></h1>
    <p>
      Add editable content to the website you already build. Keep control of the
      code, give clients control of their content.
    </p>
    <a class="ama-start" href="/quick-start/"
      >Build your first integration <ShellIcon name="arrow" /></a
    >
  </section>
  <section class="ama-home-section">
    <div class="ama-section-heading">
      <h2>Choose your starting point</h2><p>
        From a first connection to a website ready for your client.
      </p>
    </div>
    <div class="ama-home-cards">
      {
        cards.map((card) => (
          <a class="ama-home-card" href={card.href}>
            <>
              <span class="ama-home-card-icon">
                <ShellIcon name={card.icon} />
              </span>
              <h3>{card.title}</h3>
              <p>{card.description}</p>
              <span>
                {card.action} <ShellIcon name="arrow" />
              </span>
            </>
          </a>
        ))
      }
    </div>
  </section>
  <section class="ama-home-section">
    <div class="ama-section-heading"><h2>Build, verify, hand over</h2></div>
    <div class="ama-guide-table">
      <a href="/reference/fields/"
        ><strong>Find the right field</strong><span
          >Text, media, references, nested content, and validation.</span
        ><span>01 ↗</span></a
      >
      <a href="/guides/diagnostics/"
        ><strong>Check your integration</strong><span
          >Confirm connectivity, content builds, and preview state.</span
        ><span>02 ↗</span></a
      >
      <a href="/ai-assistant/"
        ><strong>Prepare the client handoff</strong><span
          >Make editing, previewing, and publishing predictable.</span
        ><span>03 ↗</span></a
      >
    </div>
  </section>
</div>
