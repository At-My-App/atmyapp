---
import AtMyAppAnalytics from "./AtMyAppAnalytics.astro";
import { getAtMyApp, getAtMyAppConfiguration } from "../server";
import type { AstroClientOptions } from "../config";
import { fetchWebsiteMetadataOnce } from "../websiteMetadata";
import { resolveMetadata, safeJson, type Metadata } from "../metadata";
export type Props = Metadata & {
  clientOptions?: AstroClientOptions;
  defaults?: Metadata;
  trackPageView?: boolean;
  metadataError?: "throw" | "fallback";
};
const {
  clientOptions,
  defaults = {},
  trackPageView = false,
  metadataError = "throw",
  ...page
} = Astro.props;
const client = getAtMyApp(Astro, clientOptions);
const configuration = getAtMyAppConfiguration(Astro, clientOptions);
let managed: Metadata = {};
try {
  managed = await fetchWebsiteMetadataOnce(client);
} catch {
  if (metadataError === "throw" || configuration.preview)
    throw new Error(
      "AtMyApp: website metadata could not be loaded. Check configuration and preview access.",
    );
  console.warn("[AtMyApp] Using local metadata fallback.");
}
const meta = resolveMetadata(
  page,
  managed,
  defaults,
  Astro.url,
  Astro.site,
  configuration.preview,
);
const publicConfiguration = {
  trackPageView: trackPageView && !configuration.preview,
  apiKey: configuration.apiKey,
  baseUrl: configuration.baseUrl,
  previewKey: configuration.previewKey,
  preview: configuration.preview,
  dynamic: configuration.dynamic,
};
---

<script
  is:inline
  set:html={`window.__ATMYAPP__ = ${safeJson(publicConfiguration)};`}
/>
{meta.title && <title>{meta.title}</title>}
{meta.description && <meta name="description" content={meta.description} />}
{meta.robots && <meta name="robots" content={meta.robots} />}
{meta.canonical && <link rel="canonical" href={meta.canonical} />}
{
  meta.sitemap && (
    <link rel="sitemap" type="application/xml" href={meta.sitemap} />
  )
}
{meta.ogTitle && <meta property="og:title" content={meta.ogTitle} />}
{
  meta.ogDescription && (
    <meta property="og:description" content={meta.ogDescription} />
  )
}
{meta.ogImage && <meta property="og:image" content={meta.ogImage} />}
{meta.ogType && <meta property="og:type" content={meta.ogType} />}
{meta.siteName && <meta property="og:site_name" content={meta.siteName} />}
{meta.canonical && <meta property="og:url" content={meta.canonical} />}
{meta.twitterCard && <meta name="twitter:card" content={meta.twitterCard} />}
{meta.ogTitle && <meta name="twitter:title" content={meta.ogTitle} />}
{
  meta.ogDescription && (
    <meta name="twitter:description" content={meta.ogDescription} />
  )
}
{meta.ogImage && <meta name="twitter:image" content={meta.ogImage} />}
{meta.favicon && <link rel="icon" href={meta.favicon} />}
{
  meta.appleTouchIcon && (
    <link rel="apple-touch-icon" href={meta.appleTouchIcon} />
  )
}
{meta.themeColor && <meta name="theme-color" content={meta.themeColor} />}
{
  meta.googleSiteVerification && (
    <meta
      name="google-site-verification"
      content={meta.googleSiteVerification}
    />
  )
}
{
  meta.jsonLd && (
    <script type="application/ld+json" set:html={safeJson(meta.jsonLd)} />
  )
}
{trackPageView && !configuration.preview && <AtMyAppAnalytics />}
