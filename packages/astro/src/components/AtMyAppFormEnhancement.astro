---
/**
 * Inline submission for `<AtMyAppForm enhance>`, using the framework-neutral
 * helper from `@atmyapp/core/forms` (busy state, field errors, captcha
 * resets, safe retries). The server-rendered form already carries the spam
 * trap, render time and captcha widget.
 */
---

<script>
  import { enhanceSubmissionForms } from "@atmyapp/core/forms";

  enhanceSubmissionForms("form[data-atmyapp-enhance]");
</script>
